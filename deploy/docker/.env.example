# Throwaway local values; copy to .env
POSTGRES_DB=rwx
POSTGRES_USER=rwx
POSTGRES_PASSWORD=rwx-local

# GitHub OAuth App (required: the app refuses to start without them; there is no mock login).
# Create at https://github.com/settings/developers -> New OAuth App,
# homepage URL: http://localhost:8080
# callback URL: http://localhost:8080/api/v1/auth/github/callback
RWX_GITHUB_CLIENT_ID=
RWX_GITHUB_CLIENT_SECRET=


# Contact sent in the User-Agent to Open Library (required: the app refuses to start without it).
# An email address or a URL you can be reached at, e.g. you@example.com
RWX_DATASOURCE_CONTACT=
